# Appwrite public content configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id

# Portfolio default: validates forms without saving details or opening WhatsApp.
# Set false only for a real enquiry deployment; rebuild after changing it.
NEXT_PUBLIC_DEMO_MODE=true

# Actual public domain. Netlify/Vercel deployment URL is used if unset on those hosts.
# Use localhost only for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: required only when NEXT_PUBLIC_DEMO_MODE=false.
# Grant only the scopes needed to create documents; NEVER prefix this with NEXT_PUBLIC_.
APPWRITE_API_KEY=
